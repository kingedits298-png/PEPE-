        <div class="chart-panel">
            <div class="pair-header">
                <div class="pair-info">
                    <span class="pair-name">BTC / USDT</span>
                    <span class="pair-price" id="livePrice">$67,432.50</span>
                    <span class="pair-change" id="liveChange"><i class="fas fa-arrow-up"></i> +2.34%</span>
                </div>
                <div class="timeframe-tabs">
                    <button class="active">1m</button>
                    <button>5m</button>
                    <button>15m</button>
                    <button>1h</button>
                    <button>4h</button>
                </div>
            </div>

            <!-- Canvas Chart -->
            <div class="chart-container">
                <canvas id="chartCanvas"></canvas>
            </div>

            <div class="chart-stats">
                <div class="stat-item">
                    <span class="stat-label">24h High</span>
                    <span class="stat-value">$68,210.00</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">24h Low</span>
                    <span class="stat-value">$65,890.00</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">24h Volume</span>
                    <span class="stat-value">$32.4M</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">24h Change</span>
                    <span class="stat-value green">+2.34%</span>
                </div>
            </div>
        </div>

        <!-- ORDER PANEL -->
        <div class="order-panel">
            <div class="order-tabs" id="orderTabs">
                <button class="buy active" data-side="buy"><i class="fas fa-arrow-up"></i> Buy</button>
                <button class="sell" data-side="sell"><i class="fas fa-arrow-down"></i> Sell</button>
            </div>

            <div class="order-type-selector">
                <button class="active">Market</button>
                <button>Limit</button>
                <button>Stop</button>
            </div>

            <div class="input-group">
                <div class="input-label">
                    <span>Price</span>
                    <span>≈ $67,432.50</span>
                </div>
                <div class="input-wrapper">
                    <i class="fas fa-dollar-sign"></i>
                    <input type="text" class="input-field" value="67,432.50" id="priceInput">
                    <span class="input-suffix">USDT</span>
                </div>
            </div>

            <div class="input-group">
                <div class="input-label">
                    <span>Amount</span>
                    <span>Available: 0.362 BTC</span>
                </div>
                <div class="input-wrapper">
                    <i class="fas fa-bitcoin-sign"></i>
                    <input type="text" class="input-field" placeholder="0.00" id="amountInput">
                    <span class="input-suffix">BTC</span>
                </div>
            </div>

            <div class="quick-percent">
                <button data-percent="25">25%</button>
                <button data-percent="50">50%</button>
                <button data-percent="75">75%</button>
                <button data-percent="100">100%</button>
            </div>

            <div class="input-group">
                <div class="input-label">
                    <span>Total</span>
                    <span id="totalUsdt">≈ $0.00</span>
                </div>
            </div>

            <button class="submit-order buy" id="submitBtn">
                <i class="fas fa-arrow-up"></i> Buy BTC
            </button>
        </div>
    </div>

